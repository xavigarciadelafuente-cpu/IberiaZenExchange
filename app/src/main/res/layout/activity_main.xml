<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"> <ImageView
    android:id="@+id/bgView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:importantForAccessibility="no"
    android:src="@drawable/bg_sakura"
    android:scaleType="centerCrop"
    android:alpha="0.40" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="20dp"
        android:weightSum="12">

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.5" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.2"
            android:text="@string/iberia_zen_nexchange"
            android:textColor="#BC002D"
            android:textSize="22sp"
            android:textStyle="bold"
            android:fontFamily="serif"
            android:textAlignment="center"
            android:letterSpacing="0.2"
            android:gravity="center"
            tools:ignore="RtlCompat" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="2.0"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:background="@drawable/bg_clock_bubble_mini"
            android:paddingHorizontal="25dp"
            android:paddingVertical="8dp"
            android:layout_marginVertical="10dp"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tori"
                android:textSize="22sp"
                android:layout_marginBottom="2dp"/>

            <LinearLayout
                android:layout_width="160dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">
                    <TextClock
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:timeZone="Europe/Madrid"
                        android:format12Hour="HH:mm"
                        android:textColor="#BC002D"
                        android:textSize="17sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/madrid"
                        android:textColor="#4A4A4A"
                        android:textSize="9sp"
                        tools:ignore="SmallSp" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="22dp"
                    android:background="#D8A4B0"
                    android:layout_gravity="center"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">
                    <TextClock
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:timeZone="Asia/Tokyo"
                        android:format12Hour="HH:mm"
                        android:textColor="#BC002D"
                        android:textSize="17sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tokyo"
                        android:textColor="#4A4A4A"
                        android:textSize="9sp"
                        tools:ignore="SmallSp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="6.3"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp"
                    app:strokeColor="#FFB7C5"
                    app:strokeWidth="1dp"
                    app:cardBackgroundColor="#CCFFFFFF"
                    android:layout_marginBottom="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/euros"
                            android:textColor="#D8A4B0"
                            android:textSize="12sp"
                            android:textStyle="bold"/>
                        <EditText
                            android:id="@+id/etEuro"
                            android:layout_width="match_parent"
                            android:layout_height="55dp"
                            android:hint="@string/_0_00"
                            android:inputType="numberDecimal"
                            android:textColor="#4A4A4A"
                            android:textSize="24sp"
                            android:background="@drawable/bg_minimal_input"
                            android:paddingHorizontal="15dp"
                            android:layout_marginTop="8dp"
                            android:autofillHints="none" />
                        <TextView
                            android:id="@+id/tvJpyResult"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/_0_000"
                            android:textColor="#FFB7C5"
                            android:textSize="28sp"
                            android:layout_gravity="end"
                            android:layout_marginTop="8dp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp"
                    app:strokeColor="#FFB7C5"
                    app:strokeWidth="1dp"
                    app:cardBackgroundColor="#CCFFFFFF">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/yenes"
                            android:textColor="#D8A4B0"
                            android:textSize="12sp"
                            android:textStyle="bold"/>
                        <EditText
                            android:id="@+id/etJpy"
                            android:layout_width="match_parent"
                            android:layout_height="55dp"
                            android:hint="@string/_0"
                            android:inputType="numberDecimal"
                            android:textColor="#4A4A4A"
                            android:textSize="24sp"
                            android:background="@drawable/bg_minimal_input"
                            android:paddingHorizontal="15dp"
                            android:layout_marginTop="8dp"
                            android:autofillHints="none" />
                        <TextView
                            android:id="@+id/tvEurResult"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/_0_0000"
                            android:textColor="#FFB7C5"
                            android:textSize="28sp"
                            android:layout_gravity="end"
                            android:layout_marginTop="8dp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </ScrollView>

        <TextView
            android:id="@+id/tvRate"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:text="@string/actualizando_datos"
            android:gravity="center"
            android:textColor="#4A4A4A"
            android:textSize="11sp"/>

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>